+#if defined(__ANDROID__)
+#include <linux/dma-heap.h>
+#include <sys/ioctl.h>
+
+static VkResult
+vkr_dma_heap_get_fd_info_from_allocation_info(struct vkr_device *dev,
+                                              VkMemoryAllocateInfo *alloc_info,
+                                              uint32_t property_flags,
+                                              int *out_dma_buf_fd,
+                                              VkImportMemoryFdInfoKHR *out_fd_info)
+{
+   struct vkr_physical_device *physical_dev = dev->physical_device;
+   struct dma_heap_allocation_data heap_alloc = {
+      .len = align(alloc_info->allocationSize, getpagesize()),
+      .fd_flags = O_RDWR | O_CLOEXEC,
+   };
+   if (ioctl(physical_dev->dma_heap_fd, DMA_HEAP_IOCTL_ALLOC, &heap_alloc)) {
+      vkr_log("DMA_HEAP_IOCTL_ALLOC of %llu bytes failed (%s)",
+              (unsigned long long)heap_alloc.len, strerror(errno));
+      return errno == ENOMEM ? VK_ERROR_OUT_OF_DEVICE_MEMORY : VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+   const int dma_buf_fd = (int)heap_alloc.fd;
+
+   /* The driver may accept imports into fewer memory types than it advertises (Mali: only
+    * its cached host-visible type); pick the closest accepted one. */
+   VkMemoryFdPropertiesKHR fd_props = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR,
+   };
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   if (vk->GetMemoryFdPropertiesKHR &&
+       vk->GetMemoryFdPropertiesKHR(dev->base.handle.device,
+                                    VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+                                    dma_buf_fd, &fd_props) == VK_SUCCESS &&
+       fd_props.memoryTypeBits &&
+       !(fd_props.memoryTypeBits & (1u << alloc_info->memoryTypeIndex))) {
+      const VkMemoryPropertyFlags wanted =
+         property_flags & (VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT | VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT);
+      const uint32_t spoofed = physical_dev->mem_type_spoof ? 1 : 0;
+      uint32_t chosen = UINT32_MAX;
+      for (uint32_t host = 0; host + spoofed < physical_dev->memory_properties.memoryTypeCount; host++) {
+         if (!(fd_props.memoryTypeBits & (1u << host)))
+            continue;
+         const VkMemoryPropertyFlags flags =
+            physical_dev->memory_properties.memoryTypes[host + spoofed].propertyFlags;
+         if (chosen == UINT32_MAX || (flags & wanted) == wanted) {
+            chosen = host;
+            if ((flags & wanted) == wanted)
+               break;
+         }
+      }
+      if (chosen != UINT32_MAX)
+         alloc_info->memoryTypeIndex = chosen;
+   }
+
+   const int import_fd = os_dupfd_cloexec(dma_buf_fd);
+   if (import_fd < 0) {
+      close(dma_buf_fd);
+      return VK_ERROR_TOO_MANY_OBJECTS;
+   }
+
+   alloc_info->allocationSize = heap_alloc.len;
+   *out_dma_buf_fd = dma_buf_fd;
+   *out_fd_info = (VkImportMemoryFdInfoKHR){
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+      .pNext = alloc_info->pNext,
+      .fd = import_fd,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+   };
+   return VK_SUCCESS;
+}
+
+#else
+
+static inline VkResult
+vkr_dma_heap_get_fd_info_from_allocation_info(UNUSED struct vkr_device *dev,
+                                              UNUSED VkMemoryAllocateInfo *alloc_info,
+                                              UNUSED uint32_t property_flags,
+                                              UNUSED int *out_dma_buf_fd,
+                                              UNUSED VkImportMemoryFdInfoKHR *out_fd_info)
+{
+   return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+}
+
+#endif
