diff --git a/src/venus/vkr_physical_device.c b/src/venus/vkr_physical_device.c
index 7a1c221..fd001ca 100644
--- a/src/venus/vkr_physical_device.c
+++ b/src/venus/vkr_physical_device.c
@@ -43,6 +43,45 @@ vkr_physical_device_get_udmabuf_dev_fd(void)
 
 #endif /* HAVE_LINUX_UDMABUF_H */
 
+#if defined(__ANDROID__)
+#include <fcntl.h>
+
+static int dma_heap_fd = -1;
+
+/* The memory types such a driver accepts imports into are cached but not coherent, so
+ * guest mappings of cached heap buffers read stale lines after GPU writes. Uncached heap
+ * buffers have no CPU lines to go stale, matching the driver's own coherent type. */
+static void
+vkr_dma_heap_init_once(void)
+{
+   static const char *const heaps[] = { "/dev/dma_heap/system-uncached", "/dev/dma_heap/system" };
+   for (unsigned i = 0; i < sizeof(heaps) / sizeof(heaps[0]) && dma_heap_fd < 0; i++) {
+      dma_heap_fd = open(heaps[i], O_RDONLY | O_CLOEXEC);
+      if (dma_heap_fd >= 0)
+         vkr_log("shareable memory comes from %s", heaps[i]);
+   }
+   if (dma_heap_fd < 0)
+      vkr_log("failed to open a system dma heap: %s", strerror(errno));
+}
+
+static inline int
+vkr_physical_device_get_dma_heap_fd(void)
+{
+   static once_flag dma_heap_once_flag = ONCE_FLAG_INIT;
+   call_once(&dma_heap_once_flag, vkr_dma_heap_init_once);
+   return dma_heap_fd;
+}
+
+#else
+
+static inline int
+vkr_physical_device_get_dma_heap_fd(void)
+{
+   return -1;
+}
+
+#endif
+
 #ifdef ENABLE_GBM_ALLOCATION
 #include <gbm.h>
