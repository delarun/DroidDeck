+/* With dma_heap_fd, dma-buf export is served by allocating from the heap and importing, so
+ * whatever the driver can import as a dma-buf can be exported too. */
+static void
+vkr_physical_device_add_dma_heap_export(const struct vkr_physical_device *physical_dev,
+                                        VkExternalMemoryHandleTypeFlagBits handle_type,
+                                        VkExternalMemoryProperties *props)
+{
+   if (physical_dev->dma_heap_fd < 0 ||
+       handle_type != VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT ||
+       !(props->externalMemoryFeatures & VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT))
+      return;
+
+   props->externalMemoryFeatures |= VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT;
+   props->exportFromImportedHandleTypes |= VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+   props->compatibleHandleTypes |= VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+}
+
 static void
 vkr_dispatch_vkGetPhysicalDeviceImageFormatProperties2(
    UNUSED struct vn_dispatch_context *dispatch,
@@ -818,6 +835,17 @@
    vn_replace_vkGetPhysicalDeviceImageFormatProperties2_args_handle(args);
    args->ret = vk->GetPhysicalDeviceImageFormatProperties2(
       args->physicalDevice, args->pImageFormatInfo, args->pImageFormatProperties);
+
+   if (args->ret != VK_SUCCESS)
+      return;
+   const VkPhysicalDeviceExternalImageFormatInfo *external_info = vkr_find_struct(
+      args->pImageFormatInfo->pNext,
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO);
+   VkExternalImageFormatProperties *external_props = vkr_find_struct(
+      args->pImageFormatProperties->pNext, VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES);
+   if (external_info && external_props)
+      vkr_physical_device_add_dma_heap_export(physical_dev, external_info->handleType,
+                                              &external_props->externalMemoryProperties);
 }
 
